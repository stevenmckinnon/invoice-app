# Local development defaults — committed, and deliberately free of secrets.
#
# Loaded only when NODE_ENV=development, and sits below .env.local in Next.js's
# load order, so a fresh clone runs against the local postgres container
# (compose.yaml) without touching a hosted database, while you can still
# override any of it in your own untracked .env.local.
#
# The credentials match compose.yaml and grant nothing beyond that container.
DATABASE_URL="postgresql://caley:caley@localhost:55432/caley_dev"

# Lets the database-backed half of `pnpm test` run instead of skipping. Those
# tests create and delete their own throwaway user, so they sit alongside the
# seeded data without disturbing it.
TEST_DATABASE_URL="postgresql://caley:caley@localhost:55432/caley_dev"
