# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# ...except the two that carry no secrets and that a fresh clone needs:
# the template, and the local-database defaults that keep `pnpm dev` off the
# hosted database. Personal overrides still belong in .env.local, which Next.js
# loads ahead of .env.development and which stays ignored.
!.env.example
!.env.development

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Prisma
/src/generated/prisma
*.db
*.db-journal
/prisma/dev.db*
/prisma/prisma/

.agents
.claude
skills-lock.json