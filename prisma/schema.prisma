// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String    @id @default(cuid())
  name          String?
  firstName     String?
  lastName      String?
  email         String    @unique
  emailVerified Boolean   @default(false)
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  
  // Profile fields for invoices
  fullName      String?
  addressLine1  String?
  addressLine2  String?
  city          String?
  state         String?
  postalCode    String?
  country       String?
  dateOfBirth   DateTime?
  
  // Banking details
  iban          String?
  swiftBic      String?
  accountNumber String?
  sortCode      String?
  bankAddress   String?
  currency      String?   @default("GBP")
  
  accounts      Account[]
  sessions      Session[]
  invoices      Invoice[]
  clients       Client[]
  photo         UserPhoto?
}

/// Avatar bytes live here rather than in User.image, which better-auth copies
/// verbatim into the session cookie — a base64 data URI there pushed the cookie
/// past its 4093-byte limit and silently disabled the session cookie cache.
/// User.image holds the URL of the route that serves this instead.
model UserPhoto {
  userId      String   @id
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  data        Bytes
  contentType String
  updatedAt   DateTime @updatedAt
}

model Account {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  issuer                String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
}

model Session {
  id        String   @id @default(cuid())
  expiresAt DateTime
  token     String   @unique
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([identifier, value])
}

model Invoice {
  id                 String   @id @default(cuid())
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  // User relationship
  userId             String
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Client relationship (nullable for legacy/one-off invoices)
  clientId           String?
  client             Client?  @relation(fields: [clientId], references: [id], onDelete: SetNull)

  // Identification
  // Unique per user, not globally: two freelancers can both have INV-2601
  invoiceNumber      String
  invoiceDate        DateTime
  showName           String

  // Personal details
  fullName           String
  email              String
  addressLine1       String
  addressLine2       String?
  city               String
  state              String?
  postalCode         String
  country            String

  // Client details
  clientName         String?
  clientAddress1     String?
  clientAddress2     String?
  clientCity         String?
  clientState        String?
  clientPostalCode   String?
  clientCountry      String?
  attentionTo        String?

  // Banking details
  iban               String
  swiftBic           String
  accountNumber      String?
  sortCode           String?
  bankAddress        String?
  dateOfBirth        DateTime?
  currency           String    @default("GBP")

  // Work inputs
  regularHours       Int      @default(0)
  overtimeHours      Int      @default(0)
  regularRate        Decimal  // per hour
  overtimeRate       Decimal  // per hour
  perDiemDays        Int      @default(0)
  perDiemRate        Decimal  // per day
  travelDays         Int      @default(0)
  travelDayRate      Decimal  // per day

  // Calculated amounts
  subtotalLabor      Decimal
  subtotalPerDiem    Decimal
  subtotalTravel     Decimal
  totalAmount        Decimal

  status             String   @default("draft") // draft, sent, paid, overdue
  notes              String?

  // Snapshot of the client's billing terms when the invoice was created
  // (day rate, per diems, overtime tier, travel + work rule). Bills are worked
  // out from these, never from the live client, so raising a client's rate
  // later can't re-price a sent invoice: the same reason the client's
  // address is copied above. Null on invoices that predate days.
  terms              Json?

  items              InvoiceLineItem[]
  overtimeEntries    OvertimeEntry[]
  customExpenseEntries CustomExpenseEntry[]
  // The dated days of the job. Empty on count-based invoices made before
  // days existed; those keep their stored lines and are never converted.
  days               InvoiceDay[]

  @@unique([userId, invoiceNumber])
}

// One billed date of a job. A day off is the absence of a row, never a row.
// The line items, overtime entries and total stay the stored billing output:
// they're worked out from these days and the invoice's terms on every save.
model InvoiceDay {
  id            String   @id @default(cuid())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  date          DateTime @db.Date
  type          String   // 'work' | 'travel' | 'dark'
  // Work days only: travel that day too. 'out' = flew in before work,
  // 'home' = flew home after wrap. How it bills is the client's rule.
  alsoTravel    String?
  // Travel days only: 'out' | 'home'. Null means work it out from the days
  // around it; set when that guess is wrong.
  direction     String?
  // Hours past a 10-hour day, work days only. Split 1.5x / 2x by the tier,
  // per day, at bill time.
  overtimeHours Decimal?

  invoiceId     String
  invoice       Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@unique([invoiceId, date])
}

model InvoiceLineItem {
  id          String  @id @default(cuid())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  description String
  quantity    Int
  unitPrice   Decimal
  cost        Decimal

  invoiceId   String
  invoice     Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
}

model OvertimeEntry {
  id          String   @id @default(cuid())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  date        DateTime
  hours       Decimal
  rateType    String   // '1.5x' or '2x'
  description String?

  invoiceId   String
  invoice     Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
}

model CustomExpenseEntry {
  id          String  @id @default(cuid())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  description String
  quantity    Int
  unitPrice   Decimal
  cost        Decimal

  invoiceId   String
  invoice     Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
}

model Client {
  id          String   @id @default(cuid())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // User relationship
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Client information
  name        String
  addressLine1 String?
  addressLine2 String?
  city        String?
  state       String?
  postalCode  String?
  country     String?
  attentionTo String?
  
  // Rate information for this client
  dayRate     Decimal?  // Day rate for work, travel, and dark days
  perDiemWork Decimal?  // Per diem rate for work days
  perDiemTravel Decimal? // Per diem rate for travel days

  // Tiered overtime terms. Null overtimeTierHours means no tiering — one rate
  // for the whole entry. The tier resets each day, not each invoice.
  overtimeTierHours Decimal? // Hours at the first rate, per day (e.g. 2)
  overtimeFirstRate String?  // '1.5x' or '2x'
  overtimeAfterRate String?  // '1.5x' or '2x'

  // A work day that also had travel (flew in, or flew home after wrap).
  // travelWorkBill: 'both' (a work day and a travel day), 'work' or 'travel'.
  // travelWorkPerDiem: which per diem that day gets, 'travel' or 'work'.
  travelWorkBill    String @default("both")
  travelWorkPerDiem String @default("travel")

  // Relations
  invoices    Invoice[]
}

// Fixed-window request counters, keyed by purpose and subject
// (e.g. "chat:burst:<userId>"). Lives in Postgres so the count is shared
// across serverless instances; see src/lib/rate-limit.ts.
model RateLimit {
  key         String   @id
  count       Int
  windowStart DateTime
}
